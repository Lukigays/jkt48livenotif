# JKT48 Live WhatsApp Bot - Environment Variables
# Copy file ini ke .env dan sesuaikan kebutuhan

# WhatsApp Channel/Group JID (opsional - bisa diatur via /settarget)
# Format grup: 120363XXXX@g.us
# WA_CHANNEL_JID=

# Interval pengecekan live dalam milidetik (default: 120000 = 2 menit)
# POLL_INTERVAL_MS=120000

# Folder session WhatsApp (default: ./auth_session)
# SESSION_DIR=./auth_session

# File state (default: ./live_state.json)
# STATE_FILE=./live_state.json

# Log level: debug, info, warn, error (default: info)
# LOG_LEVEL=info

# Mode: production atau development (default: development)
# NODE_ENV=production